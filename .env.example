# Reference only — on GitHub you set these as repository Secrets instead. NEVER commit a real .env
# Official WhatsApp Agent Platform key: agent chat → Chat info → API key (keep secret!)
WHATSAPP_AGENT_API_KEY=
# WA_MODE=agent   (default when the key above is set) | baileys (unofficial, groups)
BOT_NAME=Mizanora
BOT_TIMEZONE=Asia/Karachi

# Your WhatsApp number(s), country code + digits only (no +). Owners can run code & admin groups.
OWNER_NUMBERS=923001234567
# Optional: your WhatsApp LID (send /whoami to the bot in a group to see it)
OWNER_LIDS=
# Optional: if set, ONLY these numbers (plus owners) can chat with the bot in DMs
ALLOWED_NUMBERS=
# Number the bot itself runs on (used once for pairing code login)
PAIR_NUMBER=

# Passphrase that encrypts memory + WhatsApp session before it is stored (min 12 chars)
STATE_PASSPHRASE=change-me-to-a-long-random-passphrase

# ── AI providers: add as many as you like, several keys per provider are fine ───────
# Order of failover (first = preferred):
LLM_PROVIDER_ORDER=gemini,groq,openrouter,cerebras,mistral,deepseek,together,openai,custom,ollama
GROQ_API_KEYS=
GEMINI_API_KEYS=
# Optional ladder override, comma separated (default = Mark-LIV ladder + current 3.x fallbacks):
# GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest,gemini-3.5-flash
OPENROUTER_API_KEYS=
CEREBRAS_API_KEYS=
MISTRAL_API_KEYS=
DEEPSEEK_API_KEYS=
TOGETHER_API_KEYS=
OPENAI_API_KEYS=
# Any OpenAI-compatible endpoint:
CUSTOM_BASE_URL=
CUSTOM_API_KEYS=
CUSTOM_MODEL=
# Local models (Ollama): OLLAMA_URL=http://localhost:11434
OLLAMA_URL=

# Model overrides (provider model names change often — check each provider's docs)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash

# ── Web search (optional; DuckDuckGo works without a key) ───────────────────────────
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ── Image generation (Pollinations works keyless; others optional) ──────────────────
POLLINATIONS_API_KEY=
HF_TOKEN=

# ── Voice ───────────────────────────────────────────────────────────────────────────
# STT uses Groq Whisper → OpenAI Whisper → Gemini (whichever keys exist). TTS uses edge-tts.
TTS_VOICE_UR=ur-PK-UzmaNeural
# male alternative: ur-PK-AsadNeural
SEND_TEXT_WITH_VOICE=false
# v2 voice: engines are tried left to right. 'gemini' = expressive Gemini TTS (follows mood/emotion, natural Urdu),
# 'edge' = free edge-tts (always available, needs `pip install edge-tts`), 'openai' = gpt-4o-mini-tts.
# TTS_ORDER=gemini,edge,openai        (use edge,gemini if you want to save Gemini quota)
# TTS_GEMINI_MODELS=gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts
# TTS_GEMINI_VOICE_F=Kore   TTS_GEMINI_VOICE_M=Charon
# TTS_VOICE_UR_M=ur-PK-AsadNeural   TTS_TRANSLITERATE=true   (Roman Urdu → Urdu script before speaking)

# ── Browser agent (Playwright/Chromium) ─────────────────────────────────────────────
# Local: npm i && npx playwright install --with-deps chromium
# BROWSER_ENABLED=true
# BROWSER_MAX_STEPS=14
# BROWSER_IDLE_MIN=6

# Local runs: 0 = no time limit. On GitHub Actions the workflow sets 340.
MAX_RUNTIME_MIN=0
