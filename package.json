{
  "name": "mizanora",
  "version": "2.0.0",
  "description": "Mizanora v2 — WhatsApp AI agent: expressive Urdu/Hindi/English voice with emotion, multi-engine search + deep research, autonomous headless-browser agent, recurring AI automations, persistent memory. Developed by Muaaz Iqbal.",
  "author": "Muaaz Iqbal",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "pair": "node src/index.js --pair",
    "test": "node scripts/selftest.js",
    "state:pack": "node scripts/state.js pack state.enc",
    "state:unpack": "node scripts/state.js unpack state.enc",
    "browser:install": "npx playwright install --with-deps chromium"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "latest",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0",
    "firebase-admin": "^13.0.0",
    "playwright": "^1.49.0"
  }
}
